rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Helper: check if the requesting user is an admin
    function isAdmin() {
      return request.auth != null &&
        firestore.get(/databases/(default)/documents/Users/$(request.auth.uid)).data.role == "admin";
    }

    // Helper: check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Thumbnails: public read, authenticated user write/delete
    match /thumbnails/{fileName} {
      // Anyone can view article thumbnails
      allow read: if true;

      // Authenticated users (admin or user) can upload thumbnails
      allow write: if isAuthenticated()
        && request.resource.size < 5 * 1024 * 1024  // Max 5MB
        && request.resource.contentType.matches('image/.*');  // Images only

      // Authenticated users can delete thumbnails
      allow delete: if isAuthenticated();
    }

    // Default: deny all other access
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
